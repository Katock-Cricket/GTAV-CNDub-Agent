	0xF9CF21FF = 090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090090
	0xF9D0AD47 = PRIN_ABAO
	0xF33C3CE3 = PRIN_ABDH
	0xF71A64B1 = PRIN_ABBR
	0xF77E1EF5 = PRIN_AECT
	0xF209A3E4 = PRIN_ADBC
	0xF717B37C = PRIN_ADBB
	0xF862A93C = PRIN_AEAC
	0xF1036DB8 = PRIN_ACCM
	0xF6290A19 = PRIN_ACAO
	0xF6671BF2 = PRIN_ABCU
	0xF506890C = PRIN_AEAY
	0xF6592957 = PRIN_ACAJ
	0xFA6204ED = PRIN_ACCR
	0xFB8CDC07 = PRIN_ADCU
	0xFC3DED55 = PRIN_ADBJ
	0xFC219B4F = PRIN_ADCJ
	0xFE7D50C9 = PRIN_ABAU
	0xFF5FCCB6 = PRIN_AECQ
	0xFFBF3ADB = PRIN_AEDI
	PRIN_P1_1 = ~z~機械泡泡糖公主！
	PRIN_P1_2 = ~z~主人，你在做什麼呢？
	PRIN_P1_3 = ~z~我正在看你最近那些影片的評論。
	PRIN_P1_4 = ~z~那些人有點，呃，有點......
	PRIN_P1_5 = ~z~他們是群飢渴、
	PRIN_P1_6 = ~z~孤單，
	PRIN_P1_7 = ~z~又變態的人。
	PRIN_P1_8 = ~z~那些人都是你的粉絲耶！
	PRIN_P1_9 = ~z~放尊重點。
	PRIN_P1_10 = ~z~這些人可都是你的衣食父母。
	PRIN_P1_11 = ~z~好吧。
	PRIN_P1_12 = ~z~那，他們對我有什麼看法呢？
	PRIN_P1_13 = ~z~喔，我來看看。
	PRIN_P1_14 = ~z~這個說你的男朋友太娘了，
	PRIN_P1_15 = ~z~就好像他在壽司店又當老闆又當客人，
	PRIN_P1_16 = ~z~卻不喜歡魚肉，
	PRIN_P1_17 = ~z~也不喜歡北寄貝，
	PRIN_P1_18 = ~z~他只喜歡章魚。
	PRIN_P1_19 = ~z~但是這個比喻實在太爛了。
	PRIN_P1_20 = ~z~你那個沒用，
	PRIN_P1_21 = ~z~又做作的小跟班呢？
	PRIN_P1_22 = ~z~那個老是墊著腳走路的傢伙。
	PRIN_P1_23 = ~z~搞什麼鬼？
	PRIN_P1_24 = ~z~阿崎釀酒的時候發生爆炸了！
	PRIN_P1_25 = ~z~阿崎，你這個一身酒味的小垃圾。
	PRIN_P1_26 = ~z~你還好嗎？
	PRIN_P1_27 = ~z~喔，他沒事。只是腦震盪引發的大量內出血還是什麼的。
	PRIN_P1_28 = ~z~戳他一下。
	PRIN_P1_29 = ~z~那不是阿崎的合法酒浴。
	PRIN_P1_30 = ~z~外面好像出事了。
	PRIN_P1_31 = ~z~啊！！！
	PRIN_P1_32 = ~z~啊，現在這傢伙真的死了。
	PRIN_P1_33 = ~z~他就像塊泡爛的鬆餅。
	PRIN_P1_34 = ~z~那個呢，我們可以授權那個。
	PRIN_P1_35 = ~z~對，我們就這樣辦吧。
	PRIN_P1_36 = ~z~均衡早餐的授權部分。
	PRIN_P1_38 = ~z~機械公主泡泡糖酥脆香軟爆米花，
	PRIN_P1_39 = ~z~加上特製泡軟軟鬆餅。
	PRIN_P1_40 = ~z~糟糕！
	PRIN_P1_41 = ~z~喔，古時候就有人警告說這一天一定會來的。
	PRIN_P1_42 = ~z~主人，什麼古時候的人？
	PRIN_P1_43 = ~z~就是那些在銀行工作的老扣扣屁股。
	PRIN_P1_44 = ~z~他們說會取消我的抵押品贖回權。
	PRIN_P1_45 = ~z~他們要把神聖的廟宇打掉，
	PRIN_P1_46 = ~z~拿來蓋有得來速的µ24µ小時按摩院。
	PRIN_P1_47 = ~z~加上那種，你懂的，向人口販子買的澳洲小妞，棒呆了。
	PRIN_P1_48 = ~z~你完全不用下車，
	PRIN_P1_49 = ~z~小妞會直接從窗戶探頭進來。
	PRIN_P1_50 = ~z~打手槍、打手槍、打手槍！
	PRIN_P1_51 = ~z~「哈囉大鵰，你要來個半套還是全套？」
	PRIN_P1_52 = ~z~好吧，小妞。
	PRIN_P1_53 = ~z~嘿嘿小妞，我現在有顆大球在妳家外面等著，
	PRIN_P1_54 = ~z~這顆球要打破妳家啦。
	PRIN_P1_55 = ~z~怎樣不錯吧！
	PRIN_P1_56 = ~z~冷靜點，賤東西，
	PRIN_P1_57 = ~z~我的髮型會被弄壞啦。
	PRIN_P1_58 = ~z~主人，你教我說要守規矩，
	PRIN_P1_59 = ~z~可是你為什麼帳單都不付？
	PRIN_P1_60 = ~z~我有點......呃......
	PRIN_P1_61 = ~z~太心煩了。
	PRIN_P1_62 = ~z~我還有 300 年的貸款要付，
	PRIN_P1_63 = ~z~而退休金又縮水了。
	PRIN_P1_64 = ~z~現在大家都很不好過。
	PRIN_P1_65 = ~z~退休金？我以為你是傳統的忍者主人，你不是那樣跟我說的嗎？
	PRIN_P1_66 = ~z~我是！
	PRIN_P1_67 = ~z~很多年以前
	PRIN_P1_68 = ~z~我是個傳統的忍者，
	PRIN_P1_69 = ~z~是郵政大師來著。
	PRIN_P1_70 = ~z~我當了大概......五年。
	PRIN_P1_71 = ~z~後來我領了 275 年的退休金退休了。
	PRIN_P1_72 = ~z~我可以把一張明信片射到房間的另一邊去，
	PRIN_P1_73 = ~z~把人狠狠地割傷。
	PRIN_P1_74 = ~z~在郵局工作非常爛，
	PRIN_P1_75 = ~z~一直舔、一直蓋章、一直舔、一直舔。
	PRIN_P1_76 = ~z~我他媽的啦！
	PRIN_P1_77 = ~z~就像和我第二任老婆打交道一樣。
	PRIN_P1_78 = ~z~每天工作，臉都麻了，
	PRIN_P1_79 = ~z~喝一杯咖啡休息一下，
	PRIN_P1_80 = ~z~然後再回去做一樣重複無聊的工作，
	PRIN_P1_81 = ~z~而且做完以後感覺還糟透了。
	PRIN_P1_82 = ~z~呃......
	PRIN_P2_1 = ~z~主人......
	PRIN_P2_2 = ~z~我們要怎樣救我們的房子？
	PRIN_P2_3 = ~z~媽的我知道就好了。等一下！行銷！
	PRIN_P2_4 = ~z~可是主人，自從上次我們的 DVD
	PRIN_P2_5 = ~z~被西岸的審查員打上馬賽克後，
