	0xFA60668D = ~z~這就是力量。
	0xFB4D1D15 = DREY1_AMBB
	0xFBAFD31B = ~z~我愛幹什麼就幹什麼。
	0xFCB80144 = SFX_PAUSE_230
	0xFE4B56EA = ~z~喂，這是什麼意思？
	0xFE8DF5DF = ~z~天啊，我不知道你剛剛他媽的是在說什麼，但你猜怎麼著？
	0xFF9212FB = ~z~無意冒犯，但我不會隨便看劇本的。
	DREY1_CHASE0_1 = ~z~離我遠一點！
	DREY1_CHASE0_3 = ~z~我是藝術家，我不該受到下等律法的束縛！
	DREY1_CHASE0_5 = ~z~我會讓你血流滿地，你這王八蛋。
	DREY1_CHASE1_1 = ~z~是所羅門．李察幹的，不是我！
	DREY1_CHASE1_3 = ~z~我被設計了！
	DREY1_CHASE1_5 = ~z~你根本還沒聽過我的說詞！
	DREY1_CHASE1_7 = ~z~你都寫下來了，你這該死的白癡！
	DREY1_CHASE1_9 = ~z~我為什麼會寄那封蠢信？
	DREY1_CHASE1_11 = ~z~大衛．李察，你這個混帳！
	DREY1_CHASE1_13 = ~z~這個世界要是沒有我的作品，將會毫無色彩！
	DREY1_CHASE1_15 = ~z~我會讓你在我的下一部電影裡面演出，而且是主角！我可以讓你一舉成名！
	DREY1_CHASE1_17 = ~z~你他媽的不就是這樣和里奧諾拉說的嗎？
	DREY1_CHASE1_19 = ~z~我給了她想要的，永遠不朽的名聲！
	DREY1_CHASE1_21 = ~z~我讓她永垂不朽！
	DREY1_CHASE1_23 = ~z~那現在輪到你了，混蛋。
	DREY1_CHASE1_25 = ~z~里奧諾拉討厭黑人，這是事實。
	DREY1_CHASE1_27 = ~z~她就像這城裡的大多數人一樣，只是基因比較優良，比較幸運而已！
	DREY1_CHASE1_29 = ~z~她的死和仇恨有關，不是因為我！
	DREY1_CHASE1_31 = ~z~閉上你的鳥嘴！
	DREY1_CHASE2_1 = ~z~德賴弗斯，他媽的快回到這裡。
	DREY1_CHASE2_3 = ~z~下地獄吧，無知的狗！
	DREY1_CHASE2_5 = ~z~你想和她一樣緩慢的死去嗎？
	DREY1_CHASE2_7 = ~z~我可是有二十五歲般強健的身體，你是追不到我的。
	DREY1_CHASE2_9 = ~z~像你這種無產階級是不會懂的！
	DREY1_CHASE2_11 = ~z~藝術就是一種痛苦的形式！
	DREY1_CHASE2_12 = ~z~我不期盼像你這種無知的下等人會懂！
	DREY1_CHASE2_14 = ~z~沒有黑暗，就不會有光明！你不懂嗎？
	DREY1_CHASE2_16 = ~z~因為她死去，所以其他人才能透過......
	DREY1_CHASE2_17 = ~z~我的藝術來理解真理！
	DREY1_CHASE2_19 = ~z~要了解那種痛楚，除了動手之外，還要親自去感受。
	DREY1_CHASE2_21 = ~z~那我現在可要來好好了解一下了。
	DREY1_CHASE2_22 = ~z~你他媽離我遠一點。
	DREY1_CHASE2_24 = ~z~你那時還沒出生，為什麼這麼在意？
	DREY1_CHASE2_26 = ~z~七零年代那個時候，一切都不一樣，我根本不記得那時的世界！
	DREY1_CHASE2_28 = ~z~有沒有人要幫幫我啊？
	DREY1_CHASE2_30 = ~z~想想辦法！你們難道不知道我是誰嗎？
	DREY1_CHASE2_32 = ~z~叫警察來！慢著，別叫警察！
	DREY1_END_1 = ~z~和里奧諾拉打個招呼吧，王八蛋。
}
