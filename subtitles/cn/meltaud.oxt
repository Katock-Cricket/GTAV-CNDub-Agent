	0xFF71675C = MELT_ACAD
	0xFFAEFAAF = MELT_AACS
	MELT_P1_1 = ~z~ABSµ請回答。
	MELT_P1_2 = ~z~聽得到嗎？
	MELT_P1_3 = ~z~我差點就逮到他了。
	MELT_P1_4 = ~z~最後幾隻猴子的µDNA，將可以拯救人類免於末日。
	MELT_P1_5 = ~z~但你得抓到他！
	MELT_P1_6 = ~z~我抓到他了！
	MELT_P1_7 = ~z~記得，千萬別把你的老二放進去。
	MELT_P1_8 = ~z~我為什麼要那樣做？
	MELT_P1_9 = ~z~士兵，你在做什麼呢？
	MELT_P1_10 = ~z~這代表戰爭！
	MELT_P1_11 = ~z~暑假崩潰上映！
	MELT_P1_12 = ~z~人類惹毛了他們的表親......
	MELT_P1_13 = ~z~但這是最後一次了！
	MELT_P1_14 = ~z~《人猿崛起》。
	MELT_P1_15 = ~z~因為鬼扯的後末日論而列為限制級。
	MELT_P1_16 = ~z~達爾文的問題在於，
	MELT_P1_17 = ~z~他是個生物學家。
	MELT_P1_18 = ~z~我是數學家。
	MELT_P1_19 = ~z~而我們都知道
	MELT_P1_20 = ~z~這世界上有兩種人。
	MELT_P1_21 = ~z~一種人記得怎麼計算，
	MELT_P1_22 = ~z~另一種人則可以被說服換用一種新的計算方法，
	MELT_P1_23 = ~z~好讓我們藉此騙光他們的每一分錢，
	MELT_P1_24 = ~z~並隨我們高興向他們收費。
	MELT_P1_25 = ~z~資本主義靠的就只有這麼一件事......
	MELT_P1_26 = ~z~就是源源不絕的蠢蛋。
	MELT_P1_27 = ~z~像你們這樣的蠢蛋！
	MELT_P1_28 = ~z~你們可是付錢來上學受教的。
	MELT_P1_29 = ~z~自己在家讀書有什麼錯？
	MELT_P1_30 = ~z~嗯，有兩點，
	MELT_P1_31 = ~z~第一，閱讀是娘們做的事。
	MELT_P1_32 = ~z~從來沒有人因為讀書而學到任何有用的東西。
	MELT_P1_33 = ~z~第二，
	MELT_P1_34 = ~z~你不是來這裡學習的，
	MELT_P1_35 = ~z~你來這是想認識跟你一樣的人。
	MELT_P1_36 = ~z~並且和所有其他人一樣躺在相同的輸送帶上。
	MELT_P1_37 = ~z~那條輸送帶上寫著
	MELT_P1_38 = ~z~「若我做正確的事」
	MELT_P1_39 = ~z~「若我的手段夠下流」
	MELT_P1_40 = ~z~「若我吃夠多的嬰兒」
	MELT_P1_41 = ~z~「我也能變成滿身銅臭而且沒有靈魂的有錢人。」
	MELT_P1_42 = ~z~讓我把話講清楚，
	MELT_P1_43 = ~z~我滿身銅臭......
	MELT_P1_44 = ~z~而且沒有靈魂。
	MELT_P1_45 = ~z~對！對！讚！太讚了！哇喔！~c~~n~對！
	MELT_P1_46 = ~z~我的天......
	MELT_P1_47 = ~z~費奇老師，我好愛聽你的課。
	MELT_P1_48 = ~z~剛剛真是太棒了。
	MELT_P1_49 = ~z~我超愛你把股票講得刺激到不行。
	MELT_P1_50 = ~z~對，對。
	MELT_P1_51 = ~z~還有你說什麼買股票就像是
	MELT_P1_52 = ~z~一種更酷的姦淫擄掠手段。
	MELT_P1_53 = ~z~小姐們，長話短說。
	MELT_P1_54 = ~z~你們在浪費我時間，而大家都知道時間很貴。
	MELT_P1_55 = ~z~你以為我會罩你，
	MELT_P1_56 = ~z~在你人生中扮演父親的角色
	MELT_P1_57 = ~z~讓你跟我女兒約會，
	MELT_P1_58 = ~z~到頭來等著你背叛我？
	MELT_P1_59 = ~z~那你就別再浪費我時間了，
	MELT_P1_60 = ~z~讓我們繼續這個有的沒的故事。
	MELT_P1_61 = ~z~好，聽起來不錯。
	MELT_P1_62 = ~z~我們開始吧。
	MELT_P1_63 = ~z~聽著，我有輛跑車，
	MELT_P1_64 = ~z~很有錢，
	MELT_P1_65 = ~z~也很忙。
	MELT_P1_66 = ~z~不過，最能令我感到快樂的
	MELT_P1_67 = ~z~讓貪婪的無知青年變得墮落......
	MELT_P1_68 = ~z~只是......
	MELT_P1_69 = ~z~我只能收你們其中一人。
	MELT_P1_70 = ~z~所以......
	MELT_P1_71 = ~z~跟你的朋友說再見吧。
	MELT_P1_72 = ~z~可......可......可是我們是死黨......
	MELT_P1_73 = ~z~我們一起搬來自由市
	MELT_P1_74 = ~z~追求股票交易的夢想。
	MELT_P1_75 = ~z~抱歉，年輕人！
	MELT_P1_76 = ~z~你該拋開過往的自己，
	MELT_P1_77 = ~z~然後去見識些光鮮亮麗的世面
	MELT_P1_78 = ~z~往成為大咖的路上走！
	MELT_P1_79 = ~z~他只是你和這故事發展的阻礙。
	MELT_P1_80 = ~z~你還是能擁有這一切！
	MELT_P1_81 = ~z~等等，你是指這整個城市？
	MELT_P1_82 = ~z~你要做的，就只是拋下朋友
	MELT_P1_83 = ~z~並且拋開所謂的價值觀。
	MELT_P1_84 = ~z~好耶！我加入！
	MELT_P1_85 = ~z~唷！
	MELT_P1_86 = ~z~那是什麼？
	MELT_P1_87 = ~z~後製音效。
	MELT_P1_88 = ~z~喔......
	MELT_P1_89 = ~z~所以你的意思是這一切......
	MELT_P1_90 = ~z~都屬於你？
	MELT_P1_91 = ~z~都是靠把別人的事業搗毀賣掉賺來的。
	MELT_P1_92 = ~z~那時候我就知道，
	MELT_P1_93 = ~z~假掰旁白出場的時候到了。
	MELT_P2_1 = ~z~股票。
	MELT_P2_2 = ~z~信用違約交換。
	MELT_P2_3 = ~z~這一切都是資本主義循環搞出來的爛產物。
	MELT_P2_4 = ~z~天呀，老兄！
	MELT_P2_5 = ~z~你把數學講得真有同志情。
	MELT_P2_6 = ~z~其實就像橄欖球。
	MELT_P2_7 = ~z~你定好一個戰術，
	MELT_P2_8 = ~z~你拍了另一個男人的屁股，
	MELT_P2_9 = ~z~然後整件事情就都失控了
	MELT_P2_10 = ~z~最後大家腦子全都壞掉。
	MELT_P2_11 = ~z~好，對，我想我......
	MELT_P2_12 = ~z~我想我懂了。
	MELT_P2_13 = ~z~她是誰？
	MELT_P2_14 = ~z~一個劇情設定的無腦辣妹？
	MELT_P2_15 = ~z~她跟我有情感糾葛嗎？
	MELT_P2_16 = ~z~那是米蘭達。
	MELT_P2_17 = ~z~她是個令人一言難盡的女子，
	MELT_P2_18 = ~z~而且她還沒有台詞。
